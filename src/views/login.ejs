<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Vocard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-white font-sans min-h-screen flex items-center justify-center">
    <div class="bg-slate-900 p-8 rounded-xl shadow-2xl border border-slate-800 text-center max-w-md w-full mx-4">
        <div class="mb-6">
            <i class="fas fa-compact-disc text-6xl text-blue-500 animate-spin-slow"></i>
        </div>
        <h1 class="text-3xl font-bold mb-2">Vocard</h1>
        <p class="text-slate-400 mb-8">The ultimate music experience for your Discord server.</p>

        <a href="<%= authorizeUrl %>" class="flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-6 rounded-lg transition-all transform hover:scale-105">
            <i class="fab fa-discord text-xl"></i>
            Login with Discord
        </a>

        <p class="mt-6 text-xs text-slate-500">
            By logging in, you agree to our Terms of Service and Privacy Policy.
        </p>
    </div>

    <style>
        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spin-slow 8s linear infinite;
        }
    </style>
</body>
</html>
